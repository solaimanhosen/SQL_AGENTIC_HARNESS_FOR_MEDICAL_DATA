# Template for Backend/.env. Copy it with: cp .env.example .env
# Backend/.env is git-ignored. Never put a real key in this template.

ANTHROPIC_API_KEY=

# Optional overrides. Defaults are shown.
# SQL_AGENT_MODEL=claude-opus-5
# SQL_AGENT_EFFORT=high             # low | medium | high | xhigh | max
# SQL_AGENT_MAX_TOKENS=16000
# SQL_AGENT_DB_PATH=synthea.db      # relative paths resolve against the Backend folder
# SQL_AGENT_CSV_DIR=data/synthea    # source CSV folder used by the loader
# SQL_AGENT_MAX_ROWS=200           # largest number of rows one agent query may return
# SQL_AGENT_ANALYSIS_MAX_ROWS=100000   # rows an analytics tool may read; only its computed table reaches the model
# SQL_AGENT_QUERY_TIMEOUT=15       # seconds before a query is stopped
# SQL_AGENT_AS_OF_DATE=latest       # latest | today | YYYY-MM-DD (see Documents/decisions/0002)
# SQL_AGENT_REFUSAL_FALLBACK=true
# SQL_AGENT_CORS_ORIGINS=http://localhost:4200   # comma-separated origins allowed to call the service

# The HTTP service. Everyone signs in with an account (python -m sql_agent.users create ...).
# SQL_AGENT_SECURE_COOKIES=true      # session cookie over HTTPS only. Chrome and Firefox also keep it on
#                                    # http://localhost. false is for plain HTTP on this machine only,
#                                    # and then the service refuses to listen anywhere else.
# SQL_AGENT_REGISTRATION=open        # open | closed: whether anyone may sign up. An admin can change it later.
# SQL_AGENT_USER_DAILY_TOKEN_BUDGET=1000000   # model tokens one person may spend per UTC day
# SQL_AGENT_PUBLIC_URL=http://localhost:4200   # the address people open; Google returns them here
# SQL_AGENT_MAX_CONCURRENT_RUNS=4    # questions answered at once; more are refused
# SQL_AGENT_DAILY_TOKEN_BUDGET=5000000        # model tokens per UTC day, input and output together
# SQL_AGENT_CONVERSATION_TOKEN_BUDGET=1000000 # model tokens one conversation may spend
# SQL_AGENT_REQUEST_LOG_PATH=logs/requests.jsonl   # off disables it
# SQL_AGENT_CONVERSATIONS_PATH=data/conversations.db   # where conversations are kept; off keeps them in memory
# SQL_AGENT_STORE_RESULT_ROWS=true   # false stores each answer without the rows its queries returned
# SQL_AGENT_ADMIN_LIVE_EVAL=0        # 1 lets admins start the paid live evaluation from the console

# Google sign-in. Off unless both are set. In Google Cloud Console, create an OAuth client of
# type "Web application" with the redirect URI <SQL_AGENT_PUBLIC_URL>/api/auth/google/callback.
# SQL_AGENT_GOOGLE_CLIENT_ID=
# SQL_AGENT_GOOGLE_CLIENT_SECRET=    # a secret: never commit it

# Email, for password reset links and confirming addresses. Off unless the host, username,
# password and From address are all set. Any SMTP provider works; for Gmail, turn on 2-Step
# Verification and make an app password. Test with: python -m sql_agent.mailer you@example.org
# SQL_AGENT_SMTP_HOST=smtp.gmail.com
# SQL_AGENT_SMTP_PORT=587            # 587 for STARTTLS, 465 for TLS from the start
# SQL_AGENT_SMTP_USERNAME=           # the mailbox that sends, such as you@gmail.com
# SQL_AGENT_SMTP_PASSWORD=           # an app password, not the mailbox's own: never commit it
# SQL_AGENT_MAIL_FROM=Patient data questions <you@gmail.com>   # Gmail needs the same address as the username
