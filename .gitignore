# --- Secrets: never commit ---
.env
.env.*
!.env.example
api_key.txt
*.key
*.pem
*.p12
*.pfx

# --- Local notes, planning and presentation material, not shared ---
CLAUDE.md
/*-local/

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
.venv-*/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
*.egg-info/
.ipynb_checkpoints/

# --- Databases: built by the loader or written by the service ---
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm

# --- Agent run logs and evaluation output ---
Backend/logs/
Backend/evals/results/
*.log

# --- Frontend (Angular rules are in Frontend/.gitignore) ---
node_modules/

# --- OS / editor ---
.DS_Store
Thumbs.db
.idea/
.vscode/
.claude/settings.local.json
